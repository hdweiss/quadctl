## cache.volume
create podman volume create --driver=local systemd-cache
start  -
stop   -

## data.volume
create podman volume create --driver=local --label tier=storage data
start  -
stop   -

## front.network
create podman network create --driver bridge --gateway 10.9.0.1 --subnet 10.9.0.0/24 front
start  -
stop   -

## stack.pod
create podman pod create --name stack-pod --network front --publish 9090:90
start  podman pod start stack-pod
stop   podman pod stop stack-pod

## app.container
create podman container create --name web-app --restart always --cap-add NET_ADMIN --env FOO=bar --hostname apphost --label owner=platform --network front --pod stack-pod --publish 8080:80 --read-only --user 1000 -v data:/var/lib/data -v systemd-cache:/var/cache -v /srv/html:/usr/share/nginx/html:ro docker.io/library/nginx:latest
start  -
stop   -

## shell.container
create podman container create --name systemd-shell --cap-add NET_ADMIN --cap-add NET_RAW --env "GREETING=hello world" --env TZ=UTC --health-cmd "curl -f http://localhost/health" --label owner=platform --label tier=demo docker.io/library/alpine:3.20 /bin/sh -c "echo hello world"
start  podman container start systemd-shell
stop   podman stop systemd-shell

## web.kube
create -
start  podman play kube --annotation io.containers.autoupdate=registry --configmap testdata/stack/web-config.yaml --log-driver journald --network front --publish 8888:80 --publish 8443:443 --userns keep-id testdata/stack/web.yaml
stop   podman play kube --down --force testdata/stack/web.yaml
warn   [INFO] ignoring [Install] section (systemd only)
warn   [INFO] ignoring [Unit] section (systemd only)

